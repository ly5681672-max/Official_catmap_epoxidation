#
# Microkinetic model parameters
#

# 1-hexene epoxidation with H2O2
rxn_expressions = [
    '* + H2O2_g <-> H2O2*',                                      # H2O2 adsorption
    'H2O2* + * -> Ha* + OOH*',                                   # H2O2 activation
    '* + C6H12_g <-> C6H12*',                                    # 1-hexene adsorption
    'OOH* + C6H12* + * <-> OOH-C6H12* + 2* -> C6H12O* + O* + Hb*', # epoxidation, TS
    'C6H12O* <-> C6H12O_g + *',                                  # epoxide desorption
    'Hb* + O* <-> Hb-O* + * -> OH* + *',                         # H transfer, TS
    'Ha* + OH* -> * + H2O*',                                     # water formation
    'H2O* <-> H2O_g + *',                                        # water desorption
]

# Surfaces selected for microkinetic modeling (tinb is excluded pending validation).
surface_names = [
    'tife', 'timn', 'tihf', 'tire', 'timo', 'tiv', 'tizr',
    'tico', 'titi', 'tiw', 'tita', 'ticr', 'ti', 'tini'
]

# The old c_s descriptor does not exist in the present reaction network.
# OOH_s describes H2O2 activation/intermediate stability, while O_s describes
# the stability/removal of surface oxygen after epoxidation.
descriptor_names = ['OOH_s', 'O_s']

# Ranges cover the present Ti-M data and leave a small margin for interpolation.
descriptor_ranges = [[-7.0, -2.5], [-4.0, 2.5]]
resolution = 20

# Experimental reaction temperature: 60 degC
temperature = 333.15

#
# Species definitions / reaction conditions
#
# Experimental feed:
#   1.2 g 1-hexene
#   1.2 g 30 wt% H2O2 aqueous solution
#
# This is a liquid-phase system. CatMAP's "pressure" variable is therefore used
# here as a first-order effective activity/reservoir parameter rather than as a
# literal gas-phase partial pressure. A more quantitative liquid-phase model
# should later include solution chemical potentials / solvation corrections.
species_definitions = {}

# 1-hexene organic phase: pure-liquid standard-state approximation, a ~ 1
species_definitions['C6H12_g'] = {
    'pressure': 1.0
}

# 30 wt% H2O2 aqueous solution corresponds approximately to
# x(H2O2) = 0.185 and x(H2O) = 0.815.
species_definitions['H2O2_g'] = {
    'pressure': 0.185
}

species_definitions['H2O_g'] = {
    'pressure': 0.815
}

# Epoxide is absent at the beginning of the experiment. A very small positive
# value is used instead of exactly zero for numerical robustness.
species_definitions['C6H12O_g'] = {
    'pressure': 1e-20
}

# Surface site
species_definitions['s'] = {
    'site_names': ['111'],
    'total': 1
}

# Ha/Hb denote H atoms at two different local positions and are not standard
# chemical formulae, so their elemental compositions must be supplied explicitly.
species_definitions['Ha_s'] = {
    'composition': {'H': 1}
}

species_definitions['Hb_s'] = {
    'composition': {'H': 1}
}

species_definitions['Hb-O_s'] = {
    'composition': {'H': 1, 'O': 1}
}

#
# Data / parser parameters
#
data_file = 'alkene_epoxidation_dft.pkl'
input_file = 'energies_dft_neb.txt'

#
# Thermodynamic parameters
#
# The experiment is liquid phase, while the *_g labels are reservoir species.
# Until explicit liquid/solvation free energies are available, frozen_gas avoids
# adding a gas-phase entropy correction that would be inappropriate for liquids.
gas_thermo_mode = 'frozen_gas'
adsorbate_thermo_mode = 'frozen_adsorbate'
pressure_mode = 'static'

#
# Scaling parameters
#
# Force the two selected descriptors to map directly onto the corresponding
# adsorption energies. Other species are fitted by the generalized linear scaler.
scaling_constraint_dict = {
    'OOH_s': ['+', 0, None],
    'O_s': [0, '+', None],
}

#
# Solver parameters
#
decimal_precision = 100
tolerance = 1e-50
max_rootfinding_iterations = 100
max_bisections = 3
